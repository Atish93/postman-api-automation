{
  "name": "qa-dashboard-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API server for the QA dashboard: collections, environments, runs.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "tsx src/index.ts",
