{
  "collection": {
    "info": {
      "name": "Model exam - Booking Lifecycle with 3 faults",
      "description": "A copy of the hand-built collection with three deliberate faults, used to test the debugger and self-healer.",
      "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
      {
        "key": "baseUrl",
        "value": "https://restful-booker.herokuapp.com"
      },
      {
        "key": "token",
        "value": ""
      },
      {
        "key": "bookingId",
        "value": ""
      }
    ],
    "item": [
      {
        "name": "01 Health check",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"API is up (201)\", () => pm.response.to.have.status(201));"
              ]
            }
          }
        ],
        "request": {
          "method": "GET",
          "header": [],
          "url": "{{baseUrl}}/ping"
        }
      },
      {
        "name": "02 Login - valid credentials",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test(\"Response has a non-empty token\", () => {",
                "  pm.expect(body.token).to.be.a(\"string\").and.not.be.empty;",
                "});",
                "// Save the token so later requests can use {{token}}",
                "pm.collectionVariables.set(\"token\", body.token);"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/auth",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password123\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          }
        }
      },
      {
        "name": "03 Login - wrong password (negative)",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const body = pm.response.json();",
                "pm.test(\"No token is issued\", () => pm.expect(body).to.not.have.property(\"token\"));",
                "pm.test(\"Reason is 'Bad credentials'\", () => pm.expect(body.reason).to.eql(\"Bad credentials\"));"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/auth",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"wrong\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          }
        }
      },
      {
        "name": "04 Create booking",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test(\"Returns a numeric bookingid\", () => pm.expect(body.bookingid).to.be.a(\"number\"));",
                "pm.test(\"Echoes back what we sent\", () => {",
                "  const sent = JSON.parse(pm.request.body.raw);",
                "  pm.expect(body.booking).to.eql(sent);",
                "});",
                "// Save the id so later requests can use {{bookingId}}",
                "pm.collectionVariables.set(\"bookingId\", body.bookingid);"
              ]
            }
          }
        ],
        "request": {
          "method": "POST",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Accept",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/booking",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"firstname\": \"Asha\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 150,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-01\",\n    \"checkout\": \"2027-01-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          }
        }
      },
      {
        "name": "05 Get booking",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test(\"Has the expected shape\", () => {",
                "  pm.expect(body).to.have.all.keys(\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\", \"additionalneeds\");",
                "  pm.expect(body.bookingdates).to.have.all.keys(\"checkin\", \"checkout\");",
                "});",
                "pm.test(\"Is the booking we created\", () => {",
                "  pm.expect(body.firstname).to.eql(\"Asha\");",
                "  pm.expect(body.totalprice).to.eql(150);",
                "});"
              ]
            }
          }
        ],
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Accept",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/booking/{{bookingId}}"
        }
      },
      {
        "name": "05b Filter by checkin date (same day)",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                "pm.test(\"Booking checking in on that day is included\", () => {",
                "  const ids = pm.response.json().map(b => b.bookingid);",
                "  pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"bookingId\")));",
                "});"
              ]
            }
          }
        ],
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Accept",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/booking?checkin=2027-01-01"
        }
      },
      {
        "name": "06 Update booking without token (negative)",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Rejected with 403\", () => pm.response.to.have.status(403));"
              ]
            }
          }
        ],
        "request": {
          "method": "PUT",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Accept",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/booking/{{bookingId}}",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"firstname\": \"Hacker\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 1,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-01\",\n    \"checkout\": \"2027-01-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          }
        }
      },
      {
        "name": "07 Update booking (full)",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                "pm.test(\"Price is updated to 200\", () => pm.expect(pm.response.json().totalprice).to.eql(200));"
              ]
            }
          }
        ],
        "request": {
          "method": "PUT",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Accept",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/booking/{{bookingId}}",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"firstname\": \"Asha\",\n  \"lastname\": \"Tester\",\n  \"totalprice\": 200,\n  \"depositpaid\": true,\n  \"bookingdates\": {\n    \"checkin\": \"2027-01-01\",\n    \"checkout\": \"2027-01-05\"\n  },\n  \"additionalneeds\": \"Breakfast\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          }
        }
      },
      {
        "name": "08 Update booking (partial)",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                "const body = pm.response.json();",
                "pm.test(\"Only additionalneeds changed\", () => {",
                "  pm.expect(body.additionalneeds).to.eql(\"Late checkout\");",
                "  pm.expect(body.totalprice).to.eql(200);",
                "  pm.expect(body.firstname).to.eql(\"Asha\");",
                "});"
              ]
            }
          }
        ],
        "request": {
          "method": "PATCH",
          "header": [
            {
              "key": "Content-Type",
              "value": "application/json"
            },
            {
              "key": "Accept",
              "value": "application/json"
            },
            {
              "key": "Cookie",
              "value": "token={{token}}"
            }
          ],
          "url": "{{baseUrl}}/booking/{{bookingId}}",
          "body": {
            "mode": "raw",
            "raw": "{\n  \"additionalneeds\": \"Late checkout\"\n}",
            "options": {
              "raw": {
                "language": "json"
              }
            }
          }
        }
      },
      {
        "name": "09 Delete booking",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Deleted (status 200)\", () => pm.response.to.have.status(200));"
              ]
            }
          }
        ],
        "request": {
          "method": "DELETE",
          "header": [
            {
              "key": "Cookie",
              "value": "token={{token}}"
            }
          ],
          "url": "{{baseUrl}}/booking/{{bookingId}}"
        }
      },
      {
        "name": "10 Get deleted booking (negative)",
        "event": [
          {
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "pm.test(\"Booking is gone (404)\", () => pm.response.to.have.status(404));"
              ]
            }
          }
        ],
        "request": {
          "method": "GET",
          "header": [
            {
              "key": "Accept",
              "value": "application/json"
            }
          ],
          "url": "{{baseUrl}}/booking/{{bookingId}}"
        }
      }
    ]
  }
}