# Copy to .env (never commit .env) and fill in what you need.

# AI runs: your Anthropic API key. Plain runs work without it.
ANTHROPIC_API_KEY=

# With `docker compose --profile https`: the domain that points at this server.
DOMAIN=

# Optional
# QA_MAX_PARALLEL=2        # runs at the same time (also a setting in the dashboard)
# QA_BACKUP_KEEP=7         # daily backups to keep
# QA_BACKUPS=off           # turn daily backups off
# QA_AUDIT_DAYS=365        # how long the audit log keeps entries
